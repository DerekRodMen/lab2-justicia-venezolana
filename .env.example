# ─────────────────────────────────────────────────────────────
# Force Extreme — Frontend (Next.js) — Variables de entorno
# Copia este archivo a `.env.local` y completa los valores.
# Todas las variables expuestas al navegador deben empezar con NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# URL base del backend (sin la barra final). Desarrollo local:
NEXT_PUBLIC_API_URL=http://localhost:4000
# Producción (Render): https://force-extreme-api.onrender.com

# Número de WhatsApp del gimnasio (solo dígitos, con código de país).
NEXT_PUBLIC_WHATSAPP_NUMBER=50660301104

# URL pública del sitio (para SEO, sitemap y Open Graph). Producción (Vercel):
# https://force-extreme.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
